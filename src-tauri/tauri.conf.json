{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Etch",
  "mainBinaryName": "Etch",
  "version": "0.1.2",
  "identifier": "com.menglay.etch",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Etch",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Joselay",
    "category": "DeveloperTool",
    "shortDescription": "A fast Git GUI for macOS, Windows and Linux.",
    "longDescription": "Etch is a fast, keyboard-first Git GUI built with Tauri. Multi-repo tabs, lane-colored commit graph, word-level diffs, and a neutral palette.",
    "copyright": "Copyright (c) 2026 Joselay",
    "homepage": "https://github.com/Joselay/etch",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
